{
  "name": "autop-vercel",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "electron:dev": "concurrently \"next dev -p 3000\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:pack": "electron-builder --win --x64",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/client": "^5.10.0",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "form-data": "^4.0.6",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.24.0",
    "next": "^14.1.0",
    "next-auth": "^4.24.6",
    "puppeteer": "^25.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "resend": "^6.17.2",
    "stripe": "^22.3.1",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "autoprefixer": "^10.4.18",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.35",
    "prisma": "^5.10.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "fr.autop.admin",
    "productName": "AUTOP Console Admin",
    "asar": false,
    "cscLink": null,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "node_modules/**/*",
      "package.json",
      ".next/**/*",
      "public/**/*",
      "app/**/*",
      "prisma/**/*",
      "next.config.js",
      ".env*"
    ],
    "extraResources": [],
    "win": {
      "target": [
        "dir"
      ],
      "verifyUpdateCodeSignature": false,
      "forceCodeSigning": false,
      "sign": null,
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  }
}
